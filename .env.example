# Deployed: bind sql-warehouse as an app resource; set catalog/schema in app.yaml.
# Databricks automatically supplies HOST, CLIENT_ID and CLIENT_SECRET.
# Local only: copy to .env.local and use a PAT OR OAuth credentials.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<warehouse-id>
DATABRICKS_CATALOG=media-poc
DATABRICKS_SCHEMA=gold_business
DATABRICKS_TOKEN=<local-development-token>
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=
# DATABRICKS_QUERY_TIMEOUT_SECONDS=120
# DATABRICKS_QUERY_CONCURRENCY=4
# DATABRICKS_MAX_ROWS=100000
